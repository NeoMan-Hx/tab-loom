{
  "manifest_version": 3,
  "name": "Tab Loom",
  "short_name": "Tab Loom",
  "version": "0.1.36",
  "description": "A workspace-first new tab page for collecting browser tabs.",
  "permissions": ["storage", "tabs", "tabGroups"],
  "host_permissions": ["https://api.github.com/*", "https://gist.githubusercontent.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "incognito": "not_allowed",
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
